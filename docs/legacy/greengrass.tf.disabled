# ============================================================================
# AWS IoT Greengrass v2 - Fog Computing Layer
# ============================================================================

# ============================================================================
# IAM Role para Greengrass Core Device
# ============================================================================
resource "aws_iam_role" "greengrass_core_role" {
  name = "GreengrassCoreTokenExchangeRole"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "credentials.iot.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "greengrass_core_policy" {
  role       = aws_iam_role.greengrass_core_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSGreengrassResourceAccessRolePolicy"
}

# ============================================================================
# IoT Role Alias para credenciales temporales
# ============================================================================
resource "aws_iot_role_alias" "greengrass_alias" {
  alias    = "GreengrassCoreTokenExchangeRoleAlias"
  role_arn = aws_iam_role.greengrass_core_role.arn
}

# Política adicional para IoT Core + DynamoDB + S3
resource "aws_iam_role_policy" "greengrass_additional" {
  name = "GreengrassAdditionalPermissions"
  role = aws_iam_role.greengrass_core_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "iot:Publish",
          "iot:Subscribe",
          "iot:Connect",
          "iot:Receive"
        ]
        Resource = "*"
      },
      {
        Effect = "Allow"
        Action = [
          "s3:PutObject",
          "s3:GetObject"
        ]
        Resource = "${aws_s3_bucket.fire_images.arn}/*"
      },
      {
        Effect = "Allow"
        Action = [
          "dynamodb:PutItem",
          "dynamodb:GetItem",
          "dynamodb:Query"
        ]
        Resource = aws_dynamodb_table.fire_events.arn
      },
      {
        Effect = "Allow"
        Action = [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ]
        Resource = "arn:aws:logs:*:*:*"
      }
    ]
  })
}

# ============================================================================
# Greengrass Core Device (Thing asociado al Fog Node)
# ============================================================================
# Nota: El Thing ya existe (aws_iot_thing.fog_node en iot.tf)
# Solo necesitamos el Thing Group

resource "aws_iot_thing_group" "fog_nodes" {
  name = "fog-computing-nodes"

  properties {
    attribute_payload {
      attributes = {
        environment = "production"
        type        = "fog-gateway"
      }
    }
  }
}

resource "aws_iot_thing_group_membership" "fog_node_membership" {
  thing_name       = aws_iot_thing.fog_node.name
  thing_group_name = aws_iot_thing_group.fog_nodes.name
}

# ============================================================================
# Greengrass Component: Fog Processor (Custom Component)
# ============================================================================
resource "aws_greengrassv2_component_version" "fog_processor" {
  inline_recipe = jsonencode({
    RecipeFormatVersion  = "2020-01-25"
    ComponentName        = "com.unsa.FogProcessor"
    ComponentVersion     = "1.0.0"
    ComponentDescription = "Fog Computing Orchestrator for Fire Detection System"
    ComponentPublisher   = "UNSA-Arequipa"

    ComponentConfiguration = {
      DefaultConfiguration = {
        # Mapa de proximidad: Sensor ID → Cámara IP
        sensorCameraMap = var.sensor_camera_map

        # Umbrales de detección
        thresholds = {
          temperature = 60.0  # °C
          light       = 800.0 # Nivel de luz (fuego)
          humidity    = 30.0  # % (ambiente seco)
        }

        # Configuración de red local
        local_mqtt_broker = var.fog_mqtt_broker_ip
        local_mqtt_port   = 1883

        # Endpoints AWS
        iot_endpoint = data.aws_iot_endpoint.endpoint.endpoint_address

        # Logging
        logLevel = "INFO"
      }
    }

    Manifests = [{
      Lifecycle = {
        Install = {
          Script = join("\n", [
            "pip3 install paho-mqtt boto3 requests awsiotsdk --user",
            "mkdir -p /greengrass/v2/work/com.unsa.FogProcessor"
          ])
        }

        Run = {
          Script = "python3 {artifacts:path}/fog_processor.py"
        }
      }

      Artifacts = [{
        URI       = "s3://${aws_s3_bucket.greengrass_artifacts.bucket}/fog_processor.py"
        Unarchive = "NONE"
      }]
    }]
  })
}

# ============================================================================
# S3 Bucket para artefactos de Greengrass
# ============================================================================
resource "aws_s3_bucket" "greengrass_artifacts" {
  bucket = "fire-detection-greengrass-artifacts-${data.aws_caller_identity.current.account_id}"
}

resource "aws_s3_bucket_public_access_block" "greengrass_artifacts_block" {
  bucket = aws_s3_bucket.greengrass_artifacts.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# ============================================================================
# Greengrass Deployment (Despliegue al Core Device)
# ============================================================================
resource "aws_greengrassv2_deployment" "fog_deployment" {
  target_arn = aws_iot_thing_group.fog_nodes.arn

  deployment_name = "fog-fire-detection-deployment"

  components = {
    "com.unsa.FogProcessor" = {
      component_version = aws_greengrassv2_component_version.fog_processor.component_version
    }

    # Componentes públicos de AWS (opcional para logs)
    "aws.greengrass.LogManager" = {
      component_version = "2.3.1"
      configuration_update = {
        merge = jsonencode({
          logsUploaderConfiguration = {
            systemLogsConfiguration = {
              uploadToCloudWatch = "true"
            }
            componentLogsConfigurationMap = {
              "com.unsa.FogProcessor" = {
                minimumLogLevel = "INFO"
              }
            }
          }
        })
      }
    }
  }

  deployment_policies = {
    failure_handling_policy = "ROLLBACK"
    component_update_policy = {
      timeout_in_seconds = 120
      action             = "NOTIFY_COMPONENTS"
    }
  }
}

# ============================================================================
# Data Source: AWS IoT Endpoint
# ============================================================================
data "aws_iot_endpoint" "endpoint" {
  endpoint_type = "iot:Data-ATS"
}
